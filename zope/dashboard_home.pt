<div class="staff-embed-root"
     xmlns:tal="http://xml.zope.org/namespaces/tal"
     xmlns:metal="http://xml.zope.org/namespaces/metal"
     tal:define="dashboard here/get_staff_dashboard_data | nothing;
                 live_news python:dashboard and dashboard.get('announcements') or [];
                 live_events python:dashboard and dashboard.get('events') or []">
<!--
  ============================================================================
  Staff Hub  -  dashboard home
  Purdue University, College of Engineering

  Embedded into /staff/index_html via a "Page Template Embed" block.
  Companion styles live in /staff/local.css (see prototype/staff-dashboard.css).

  DATA: get_staff_dashboard_data (Script (Python) in this folder) supplies both
  live lists. Each widget uses "live_x or [ ...dummy... ]", so real content wins
  as soon as the Purdue Event Managers hold documents, and the page still renders
  the approved dummy content if the script is missing or the managers are empty.
  Delete the dummy literals once live data is flowing.

  Target: Zope 2.13.10 / Python 2.7.18. Restricted Python only: no f-strings,
  use % formatting, and keep expressions traversal-safe.
  ============================================================================
-->

<!-- =========================== BANNER ===========================
     Native Wrap9 banner-split-motion block plus the MVP search field.
     NOTE: /staff/index_html already carries a separate banner block. Remove or
     disable that one when this template goes live, or the page shows two.     -->
<section class="block no-pad --bg-black"
         tal:define="banner_image string:controls/block_settings/banner_2025-01-01-00-00-00-000/pu-banner-1920x960.jpg">

  <div class="banner banner-split-motion staff-banner">

    <div class="container">
      <div class="split-motion-content">
        <div class="staff-banner__row">

          <div class="staff-banner__intro">
            <div class="hgroup hg-reverse">
              <h1 class="hg-heading">Welcome, Engineering Staff!</h1>
              <span class="motion-heading mh-gold">Staff Hub</span>
            </div>
            <div class="intro-text">
              Your one-stop destination for information, tools, and support
            </div>
          </div>

          <form class="staff-search" role="search" method="get"
                tal:attributes="action string:${here/absolute_url}/search">
            <label class="staff-search__label" for="staff-search-input">How can we help?</label>
            <div class="staff-search__field">
              <input class="staff-search__input" id="staff-search-input" type="search"
                     name="q" placeholder="Search site resources&#8230;" autocomplete="off" />
              <button class="staff-search__submit" type="submit">
                <span class="staff-visually-hidden">Search</span>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              </button>
            </div>
            <p class="staff-search__note">Searches guides, forms, policies and staff resources.</p>
          </form>

        </div>
      </div>
    </div>

    <div class="split-motion-image">
      <img loading="lazy" alt=""
           tal:attributes="src string:${here/absolute_url}/${banner_image}" />
    </div>

  </div>
</section>


<!-- =========================== DASHBOARD =========================== -->
<section class="block --bg-light-gray staff-dashboard">
  <div class="container">
    <div class="row g-4">

      <!-- ========= MAIN COLUMN ========= -->
      <div class="col-lg-8 staff-col-main d-flex flex-column gap-4">

        <!-- ==== New & Important ====
             LIVE SOURCE (next pass): the "announcements" Purdue Event Manager in
             this container, filtered to Document Type "News Item".
             Replace the define below with the query; keys stay the same.        -->
        <div class="staff-card"
             tal:define="announcements python:live_news or [
               {'icon': 'fa-star', 'featured': 1,
                'title': 'Bravo+ Nominations Open',
                'summary': '&lt;p&gt;Recognize a colleague who went above and beyond. Nominations are open to all College of Engineering staff, and &lt;strong&gt;any staff member may nominate&lt;/strong&gt; a peer, a team, or a supervisor.&lt;/p&gt;',
                'due': 'Sep 30',
                'url': '#'},
               {'icon': 'fa-circle', 'featured': 0,
                'title': 'PESLA Cohort 9 Applications',
                'summary': 'Apply to the Engineering Staff Leadership Academy. The cohort meets monthly across the academic year and covers strategic thinking, team leadership and change management.',
                'due': 'Oct 10&#8211;12',
                'url': '#'},
               {'icon': 'fa-circle', 'featured': 0,
                'title': 'New AI Guidance for Staff',
                'summary': &quot;What's approved, what isn't, and where to get trained.&quot;,
                'due': '',
                'url': '#'},
               {'icon': 'fa-circle', 'featured': 0,
                'title': 'Benefits Open Enrollment',
                'summary': 'Review your elections for the 2027 plan year. Medical, dental and vision selections carry over automatically, but flexible spending accounts must be re-elected each year.',
                'due': 'Oct 24 &#8211; Nov 7',
                'url': '#'},
               {'icon': 'fa-circle', 'featured': 0,
                'title': 'Welcome, New Staff',
                'summary': 'Meet the colleagues who joined the College this month.',
                'due': '',
                'url': '#'}]">

          <div class="motion-line mh-gold">
            <h2 class="motion-heading mh-gold">New &amp; Important</h2>
            <a class="staff-card__more"
               tal:attributes="href string:${here/absolute_url}/announcements">View all</a>
          </div>

          <ul class="staff-news">
            <!-- The full-text trigger is a <button>, which cannot live inside
                 an <a>, so the link now wraps the title only. Summary text
                 becomes selectable as a side benefit. -->
            <li tal:repeat="item announcements"
                tal:attributes="class python:item['featured'] and 'staff-news__item is-featured' or 'staff-news__item'">

              <i class="staff-news__icon" aria-hidden="true"
                 tal:attributes="class string:fa-solid ${item/icon} staff-news__icon"></i>

              <a class="staff-news__link" tal:attributes="href item/url">
                <span class="staff-news__title" tal:content="item/title">Announcement title</span>
              </a>

              <div class="staff-news__summary">
                <!-- structure: intro is admin-authored HTML and is rendered
                     unescaped. Only trusted editors can create these. -->
                <div class="staff-news__clamp"
                     tal:content="structure item/summary">One-line summary.</div>

                <button type="button" class="staff-news__more" hidden="hidden"
                        aria-expanded="false"
                        tal:attributes="aria-describedby string:staff-tip-${repeat/item/number}">
                  <span class="staff-visually-hidden">Show the full description</span>
                  <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                </button>

                <div class="staff-news__tip" role="tooltip" hidden="hidden"
                     tal:attributes="id string:staff-tip-${repeat/item/number}"
                     tal:content="structure item/summary">Full description.</div>
              </div>

              <span class="staff-news__due"
                    tal:condition="item/due|nothing"
                    tal:content="item/due">Closes Jan 1</span>
            </li>
          </ul>
        </div>

        <!-- ==== Quick Links ====
             Static by design. To add a link, add one dict below.               -->
        <div class="staff-card"
             tal:define="quick_links python:[
               {'label': 'Purdue Directory',
                'icon': 'fa-address-book',
                'url': 'https://engineering.purdue.edu/Engr/People/ptDirectory'},
               {'label': 'IT Help',
                'icon': 'fa-headset',
                'url': 'https://service.purdue.edu/TDClient/32/Purdue/Home/'},
               {'label': 'HR Request',
                'icon': 'fa-id-card',
                'url': 'https://service.purdue.edu/TDClient/32/Purdue/Requests/Service/84/Human-Resources-Service-Center/Request'},
               {'label': 'Purchasing Resources',
                'icon': 'fa-cart-shopping',
                'url': 'https://www.purdue.edu/operations/procurement/supplier-resources/'},
               {'label': 'Travel Resources',
                'icon': 'fa-plane',
                'url': 'https://www.purdue.edu/operations/travel/'},
               {'label': 'Engineering Forms',
                'icon': 'fa-clipboard-list',
                'url': 'toolkit#forms'}]">

          <div class="motion-line mh-gold">
            <h2 class="motion-heading mh-gold">Quick Links</h2>
            <span class="staff-card__note">Opens in a new tab</span>
          </div>

          <ul class="staff-quick">
            <li tal:repeat="link quick_links">
              <a class="staff-quick__link" target="_blank" rel="noopener"
                 tal:attributes="href python:link['url'].startswith('http') and link['url'] or '%s/%s' % (here.absolute_url(), link['url'])">
                <i class="staff-quick__icon" aria-hidden="true"
                   tal:attributes="class string:fa-solid ${link/icon} staff-quick__icon"></i>
                <span class="staff-quick__label" tal:content="link/label">Link label</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- ==== Extension slot: "How Do I...?" (Phase 2) ====
             Delete this div when the widget is built.                          -->
        <div class="staff-slot">
          <p class="staff-slot__label">Extension slot &#8212; &#8220;How Do I&#8230;?&#8221;</p>
          <p class="staff-slot__sub">Deferred to Phase 2. Drops in here with no relayout.</p>
        </div>

        <!-- ==== Explore ==== -->
        <div class="staff-card"
             tal:define="explore python:[
               {'title': 'AI Resources',
                'icon': 'fa-microchip',
                'summary': 'Find trainings, policies and tools related to AI.',
                'url': 'resources#ai'},
               {'title': 'Recognize Great Work',
                'icon': 'fa-trophy',
                'summary': 'Celebrate achievements and recognize great work of our staff.',
                'url': 'recognition'},
               {'title': 'Grow Your Career',
                'icon': 'fa-chart-line',
                'summary': 'Explore professional development programs and training opportunities.',
                'url': 'training'}]">

          <div class="motion-line mh-gold">
            <h2 class="motion-heading mh-gold">Explore</h2>
          </div>

          <ul class="staff-explore">
            <li tal:repeat="item explore">
              <a class="staff-explore__link"
                 tal:attributes="href string:${here/absolute_url}/${item/url}">
                <i class="staff-explore__icon" aria-hidden="true"
                   tal:attributes="class string:fa-solid ${item/icon} staff-explore__icon"></i>
                <span class="staff-explore__title" tal:content="item/title">Section</span>
                <p class="staff-explore__desc" tal:content="item/summary">Tagline.</p>
              </a>
            </li>
          </ul>
        </div>

      </div><!-- /main column -->

      <!-- ========= RIGHT RAIL ========= -->
      <div class="col-lg-4 staff-col-rail d-flex flex-column gap-4">

        <!-- ==== Upcoming Events ====
             LIVE SOURCE (next pass): the "calendar" Purdue Event Manager in this
             container, filtered to Document Type "Event/Function", ascending by
             start date, limited to 5. Sort/tag rules still to be defined.
             'month' and 'day' become formatted from the event date; 'when' and
             'where' come from the event's date/time and location fields.        -->
        <div class="staff-card"
             tal:define="events python:live_events or [
               {'month': 'Sep', 'day': '3',
                'title': 'Staff Council Meeting',
                'when': '10:00&#8211;11:00 AM', 'where': 'ARMS 1010', 'url': '#'},
               {'month': 'Sep', 'day': '9',
                'title': 'LinkedIn Learning: Managing Up',
                'when': '1:00&#8211;2:00 PM', 'where': 'Online (Teams)', 'url': '#'},
               {'month': 'Sep', 'day': '15',
                'title': 'Performance Review Self-Assessment Due',
                'when': 'All day', 'where': '', 'url': '#'},
               {'month': 'Sep', 'day': '22',
                'title': 'New Employee Orientation',
                'when': '9:00&#8211;11:30 AM', 'where': 'POTR 234', 'url': '#'},
               {'month': 'Sep', 'day': '30',
                'title': 'College of Engineering Town Hall',
                'when': '9:00&#8211;10:00 AM', 'where': 'Fowler Hall', 'url': '#'}]">

          <div class="motion-line mh-gold">
            <h2 class="motion-heading mh-gold">Upcoming Events</h2>
            <a class="staff-card__more"
               tal:attributes="href string:${here/absolute_url}/calendar">View calendar</a>
          </div>

          <ul class="staff-events">
            <li class="staff-event" tal:repeat="event events">

              <div class="staff-event__date">
                <span class="staff-event__month" tal:content="event/month">Sep</span>
                <span class="staff-event__day" tal:content="event/day">1</span>
              </div>

              <div>
                <h3 class="staff-event__title" tal:content="event/title">Event title</h3>
                <p class="staff-event__meta">
                  <tal:when tal:content="event/when">All day</tal:when>
                  <tal:where tal:condition="event/where|nothing"
                    ><span class="sep">|</span><tal:loc tal:content="event/where">Location</tal:loc
                  ></tal:where>
                </p>
              </div>

              <!-- Each event document auto-generates its own .ics sub-object,
                   so this links straight to it: works with Outlook desktop,
                   OWA, Apple Calendar and Google. Hidden when absent. -->
              <a class="staff-event__outlook"
                 tal:condition="event/ics | nothing"
                 tal:attributes="href event/ics">
                <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Add to Outlook<span
                  class="staff-visually-hidden"
                  tal:content="string:: ${event/title}">: Event title</span>
              </a>

            </li>
          </ul>
        </div>

        <!-- ==== Extension slot: calendar snapshot (Phase 2) ==== -->
        <div class="staff-slot">
          <p class="staff-slot__label">Extension slot &#8212; Calendar snapshot</p>
          <p class="staff-slot__sub">Week-at-a-glance view from the mockup, Phase&#160;2.</p>
        </div>

      </div><!-- /right rail -->

    </div><!-- /row -->
  </div><!-- /container -->
</section>


<!-- ======================= HAVE A SUGGESTION? =======================
     TODO: feedback form URL still outstanding.                                 -->
<section class="block --bg-black"
         tal:define="feedback_url string:#">
  <div class="container">
    <div class="staff-feedback-inner">
      <p class="staff-feedback__text">
        <span class="staff-feedback__lead">Have a suggestion?</span>
        <span class="staff-feedback__sub">Let us know how to improve this site.</span>
      </p>
      <a class="purdue-btn btn-gold"
         tal:attributes="href feedback_url">Share Feedback</a>
    </div>
  </div>
</section>

<script>
/* Full-text tooltip for clamped announcement summaries.
   Hover opens after a delay; keyboard focus opens at once; Escape closes; the
   tooltip stays open while the pointer or focus is inside it (WCAG 1.4.13).
   The trigger is revealed only when the text is actually clipped.
   Written without ampersand or less-than characters so the template
   stays valid XML. */
(function () {
  var OPEN_DELAY = 1000;
  var groups = document.querySelectorAll('.staff-news__summary');
  if (!groups.length) { return; }

  var current = null, openTimer = null, closeTimer = null, entries = [];

  function place(tip) {
    tip.style.left = '0px';
    var box = tip.getBoundingClientRect();
    var over = box.right - (window.innerWidth - 8);
    if (over > 0) { tip.style.left = (0 - over) + 'px'; }
    var after = tip.getBoundingClientRect();
    if (after.left > 8) { return; }
    tip.style.left = (parseFloat(tip.style.left || 0) + (8 - after.left)) + 'px';
  }

  function close() {
    window.clearTimeout(openTimer);
    window.clearTimeout(closeTimer);
    if (!current) { return; }
    current.tip.hidden = true;
    current.btn.setAttribute('aria-expanded', 'false');
    if (current.card) { current.card.classList.remove('has-open-tip'); }
    current = null;
  }

  function open(entry) {
    if (current) {
      if (current === entry) { return; }
      close();
    }
    entry.tip.hidden = false;
    entry.btn.setAttribute('aria-expanded', 'true');
    /* Raise the owning card so later cards cannot paint over the tooltip. */
    if (entry.card) { entry.card.classList.add('has-open-tip'); }
    place(entry.tip);
    current = entry;
  }

  function scheduleClose() {
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(close, 200);
  }

  function measure(entry) {
    var clipped = entry.clamp.scrollHeight > entry.clamp.clientHeight + 1;
    entry.btn.hidden = !clipped;
    if (!clipped) {
      if (current === entry) { close(); }
    }
  }

  Array.prototype.forEach.call(groups, function (summary) {
    var clamp = summary.querySelector('.staff-news__clamp');
    var btn = summary.querySelector('.staff-news__more');
    var tip = summary.querySelector('.staff-news__tip');
    if (!clamp) { return; }
    if (!btn) { return; }
    if (!tip) { return; }
    var entry = { clamp: clamp, btn: btn, tip: tip,
                  card: summary.closest ? summary.closest('.staff-card') : null };
    entries.push(entry);

    btn.addEventListener('mouseenter', function () {
      window.clearTimeout(closeTimer);
      window.clearTimeout(openTimer);
      openTimer = window.setTimeout(function () { open(entry); }, OPEN_DELAY);
    });
    btn.addEventListener('mouseleave', function () {
      window.clearTimeout(openTimer);
      scheduleClose();
    });
    /* Keyboard users get it immediately: a one second wait on focus would
       feel broken. */
    btn.addEventListener('focus', function () { open(entry); });
    btn.addEventListener('blur', function (ev) {
      if (ev.relatedTarget) {
        if (tip.contains(ev.relatedTarget)) { return; }
      }
      scheduleClose();
    });
    /* Click covers touch, where hover does not exist. */
    btn.addEventListener('click', function (ev) {
      ev.preventDefault();
      window.clearTimeout(openTimer);
      if (current === entry) { close(); } else { open(entry); }
    });

    tip.addEventListener('mouseenter', function () { window.clearTimeout(closeTimer); });
    tip.addEventListener('mouseleave', function () { scheduleClose(); });
    tip.addEventListener('focusout', function (ev) {
      if (ev.relatedTarget) {
        if (tip.contains(ev.relatedTarget)) { return; }
        if (ev.relatedTarget === btn) { return; }
      }
      scheduleClose();
    });

    measure(entry);
  });

  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') { close(); }
  });
  document.addEventListener('click', function (ev) {
    if (!current) { return; }
    if (current.tip.contains(ev.target)) { return; }
    if (current.btn.contains(ev.target)) { return; }
    close();
  });

  var resizeTimer = null;
  window.addEventListener('resize', function () {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(function () {
      close();
      entries.forEach(function (e) { measure(e); });
    }, 150);
  });
}());
</script>

</div><!-- /.staff-embed-root -->
